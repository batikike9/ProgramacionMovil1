<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B132B"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CRÉDITOS DEL PROYECTO"
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Asistente Biomecánico IA Móvil"
        android:textColor="#94A3B8"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="#131F37"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DESARROLLADO POR:"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIntegrantes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="6dp"
            android:text="• Víctor Enrique Yáñez Medina\n(Espacio reservado para compañero de equipo)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MATERIA Y PROFESOR:"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Programación Móvil 1 - Grupo 1807\nProf. Juan Carlos Camacho Alvarez\nUNAM FES Aragón"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="TECNOLOGÍAS:"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Java · Android SDK · CameraX · MediaPipe Pose Landmarker · TextToSpeech"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnVolverCreditos"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="#2563EB"
        android:text="VOLVER AL ENTRENAMIENTO"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</LinearLayout>